# Plaid API credentials — sign up at https://dashboard.plaid.com
PLAID_CLIENT_ID=your_client_id_here
PLAID_SECRET=your_secret_here
PLAID_ENV=sandbox

# Optional: require this password before the app shows any budget data.
# Strongly recommended whenever the server is reachable by anyone but you (e.g. on Fly).
APP_PASSWORD=

# Optional: Plaid OAuth redirect URI (must be registered in the Plaid dashboard).
# Defaults to <page origin>/plaid-oauth-return.html
# PLAID_REDIRECT_URI=https://your-app.example.com/plaid-oauth-return.html
